# Réglages du serveur de modèle sur un poste de travail.
# Installé en /etc/agentos/model.env.

# Laisser deux cœurs au bureau : sans cela, le modèle occupe toutes les
# unités de calcul et la frappe au clavier devient saccadée pendant qu'il
# génère.
AGENTOS_THREADS=2

# Fenêtre de contexte réduite : chaque millier de jetons coûte de la
# mémoire vive en cache d'attention, et sept Gio ne laissent pas la marge
# d'une machine dédiée.
AGENTOS_CTX=4096
